    {
      "parameters": {
        "jsCode": "const job = $('Claim AI Job').first().json;\nconst ctx = $json ?? {};\n\nconst history = ctx.history ?? [];\nconst lead = ctx.lead_state ?? {};\nconst knowledge = ctx.knowledge ?? [];\nconst campaigns=ctx.campaigns??[];const opportunities=ctx.opportunities??[];\n\nconst agentInput = [\n  `MODE: INBOUND_SALES`,\n `SOURCED HISTORICAL CUSTOMER EXCERPTS: ${JSON.stringify(ctx.memory??{})}`,\n `CAMPAIGNS (inferred context, ask if ambiguous): ${JSON.stringify(campaigns)}`,\n `CRM: ${JSON.stringify(opportunities)}`,\n `PROMOTIONAL OPT OUT: ${Boolean(ctx.promotional_opt_out)}`,\n  `CHAT_ID: ${job.chat_id}`,\n  `CURRENT CUSTOMER MESSAGE:\\n${job.message_text || ''}`,\n  `LEAD STATE:\\n${JSON.stringify(lead)}`,\n  `RECENT CONVERSATION HISTORY:\\n${JSON.stringify(history)}`,\n  `OFFICIAL KNOWLEDGE SNAPSHOT:\\n${JSON.stringify(knowledge)}`,\n  `Use the connected tools when you need to re-check official products, promotions, or FAQ.`\n].join('\\n\\n');\n\nreturn [{\n  json: {\n    job_id: job.job_id,\n    inbound_event_id: job.inbound_event_id,\n    chat_id: job.chat_id,\n    attempt_count: job.attempt_count ?? 1,\n    agent_input: agentInput\n  }\n}];"
      },
